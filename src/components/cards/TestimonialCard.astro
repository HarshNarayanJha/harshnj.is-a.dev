---
import { Image } from "astro:assets"
import type { CollectionEntry } from "astro:content"

interface Props {
  class: string
  testimonial: CollectionEntry<"testimonials">["data"]
  [key: string]: any
}

const { class: className, testimonial, ...rest } = Astro.props
---

<div
  class:list={[
    "bg-surface overflow-hidden rounded-xl p-6 md:p-8",
    "relative flex h-auto flex-col items-start justify-between gap-6",
    "shadow-xs transition-all duration-300 hover:shadow-md",
    className,
  ]}
  {...rest}
>
  <div
    class="bg-primary/25 pointer-events-none absolute -bottom-24 -left-24 h-48 w-48 rounded-full opacity-35 blur-lg md:opacity-75 md:blur-3xl"
  >
  </div>

  <div class="space-y-2">
    <slot name="title" />
    <slot name="text" />
  </div>

  <div class="mt-4 flex w-full shrink-0 flex-row items-center justify-start gap-3 select-none">
    <Image
      src={testimonial.img}
      alt={testimonial.name}
      width={64}
      class="h-10 w-10 shrink-0 rounded-full object-cover md:h-12 md:w-12"
    />
    <div class="flex flex-col gap-0.5 md:w-full md:gap-1">
      <slot name="name" />
      <slot name="at" />
    </div>
  </div>
</div>
